# Read from the environment, or from this file when copied to .env in the working directory.

# --- Database (Neon) -------------------------------------------------------
# Pooled connection string from the Neon console (host contains "-pooler").
# The postgresql:// form is converted to JDBC automatically; a jdbc:postgresql:// URL also works.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/talkcare?sslmode=require
# Optional: direct (non-pooled) string, used for Flyway migrations when set (recommended on Neon).
DATABASE_URL_UNPOOLED=
# Max pooled connections per API instance.
DB_POOL_MAX=10

# --- HTTP ------------------------------------------------------------------
PORT=4000
# Comma-separated list of allowed browser origins. The desktop shell serves the UI
# from http://localhost:54321.
CORS_ORIGIN=http://localhost:54321
# Public base URL of this API (used for absolute upload URLs). Optional.
PUBLIC_BASE_URL=

# --- Auth ------------------------------------------------------------------
# Random string of at least 32 characters (HS256 key), e.g. `openssl rand -hex 48`.
# Keep the value used by the Express version and existing sessions stay valid.
JWT_SECRET=
# Session lifetime: 12h, 30m, 7d, or a number of seconds.
JWT_EXPIRES_IN=12h

# --- Uploads ---------------------------------------------------------------
# Local directory for profile photos, ID documents and chat photos.
UPLOAD_DIR=./uploads

# --- Scheduling ------------------------------------------------------------
APP_TIMEZONE=Asia/Manila

# --- Environment -----------------------------------------------------------
# "production" blocks the seed command unless ALLOW_SEED=true. NODE_ENV is still honoured.
APP_ENV=development

# --- Password reset email (optional; reset is disabled when unset) ---------
TALKCARE_SMTP_HOST=
TALKCARE_SMTP_PORT=587
TALKCARE_SMTP_USERNAME=
TALKCARE_SMTP_PASSWORD=
TALKCARE_SMTP_FROM=
# Brevo HTTPS API key; use instead of SMTP where outbound SMTP is blocked (e.g. Render free plan).
# Only TALKCARE_SMTP_FROM (a verified Brevo sender) is needed alongside it.
TALKCARE_BREVO_API_KEY=
# Where the reset link should open: the desktop UI.
TALKCARE_RESET_URL=http://localhost:54321
